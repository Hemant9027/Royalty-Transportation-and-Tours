# ---------------------------------------------------------------------------
# Royalty Transportation & Tours — DEMO environment configuration
# Copy to .env and fill in values. NEVER commit real secrets to source control.
# ---------------------------------------------------------------------------

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Demo admin account (required to access /admin/*).
# The password is only used at seed time to create the scrypt-hashed demo user.
# Rotate it by deleting the demo_admin_users row and re-seeding with a new value.
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=choose-a-strong-demo-password
DEMO_SESSION_TTL_HOURS=12

# Optional: email notifications via Resend (https://resend.com).
# When unset, bookings are stored and shown in the dashboard, and the UI
# honestly reports that no email was sent.
NOTIFY_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NOTIFY_FROM="Royalty Demo <notifications@yourdomain.com>"
NOTIFY_TO=royaltytransportationandtours@yahoo.com

# Canonical site URL (used for sitemap/robots/OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
